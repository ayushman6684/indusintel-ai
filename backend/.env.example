# Database
DATABASE_URL=sqlite:///./indusintel.db
# Use Postgres in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/indusintel

# AI Provider — required for AI structuring (POST /api/products/{id}/process).
# Upload/extraction work without this; structuring does not.
# AI_PROVIDER selects which key is used: "anthropic" or "gemini".
# Get a key: https://console.anthropic.com/ (Claude) or https://aistudio.google.com/apikey (Gemini)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# App
ENV=development
CORS_ORIGINS=http://localhost:3000
